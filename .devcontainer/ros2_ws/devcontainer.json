{
    "name": "ROS 2 Python (ros2_ws)",
    "image": "osrf/ros:humble-desktop-full",
    "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "ms-iot.vscode-ros"
    ],
    "mounts": [
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
        "source=${localWorkspaceFolder}/ros2_ws,target=/root/ros2_ws,type=bind,consistency=cached"
    ],
    "environment": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "QT_X11_NO_MITSHM": "1"
    },
    "workspaceFolder": "/root/ros2_ws",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "runArgs": [
        "--privileged"
    ],
    "postStartCommand": "sudo apt update && sudo apt install -y python3-pip gdb",
    "customizations": {
        "vscode": {
            "settings": {
                "python.analysis.extraPaths": [
                    "/opt/ros/humble/lib/python3.10/site-packages"
                ]
            }
        }
    }
}
