{
    "name": "ROS 2 Python (ros2_ws)",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "ros2-humble",
    "workspaceFolder": "/root/ros2_ws",
    "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "ms-iot.vscode-ros"
    ],
    "postStartCommand": "sudo apt update && sudo apt install -y python3-pip gdb",
    "customizations": {
        "vscode": {
            "settings": {
                "python.analysis.extraPaths": [
                    "/opt/ros/humble/lib/python3.10/site-packages"
                ]
            }
        }
    }
}
