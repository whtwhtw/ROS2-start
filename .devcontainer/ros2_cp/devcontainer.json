{
    "name": "ROS 2 C++ (ros2_cp)",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "ros2-humble-cp",
    "workspaceFolder": "/root/ros2_cp",
    "postStartCommand": "sudo apt update && sudo apt install -y gdb",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-extension-pack",
                "ms-vscode.cmake-tools",
                "ms-iot.vscode-ros"
            ],
            "settings": {
                "C_Cpp.intelliSenseEngine": "default",
                "C_Cpp.errorSquiggles": "enabled",
                "C_Cpp.default.includePath": [
                    "/opt/ros/humble/include/**"
                ]
            }
        }
    },
    "remoteUser": "root"
}